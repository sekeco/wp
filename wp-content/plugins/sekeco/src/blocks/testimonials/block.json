{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/testimonials",
	"version": "1.0.0",
	"title": "Testimonials",
	"category": "sekeco-content",
	"description": "Client words in three layouts: a slider with one large quote at a time, a grid of cards, or an endless marquee of cards. Add Testimonial blocks inside. Hides itself until at least one has a quote.",
	"keywords": [ "testimonials", "reviews", "quotes", "clients", "slider", "carousel" ],
	"textdomain": "sekeco",
	"attributes": {
		"layout": { "type": "string", "default": "slider" },
		"duration": { "type": "number", "default": 60 }
	},
	"allowedBlocks": [ "sekeco/testimonial" ],
	"supports": { "align": [ "wide", "full" ], "anchor": true, "html": false },
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
