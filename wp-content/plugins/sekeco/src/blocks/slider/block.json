{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/slider",
	"version": "0.1.2",
	"title": "Slider",
	"category": "sekeco",
	"icon": "images-alt2",
	"description": "A generic, accessible slider. Use manual slides or query Works, Portfolio, or Post entries.",
	"keywords": [ "slider", "carousel", "portfolio", "works" ],
	"textdomain": "sekeco",
	"attributes": {
		"mode": {
			"type": "string",
			"default": "inner"
		},
		"perView": {
			"type": "number",
			"default": 3
		},
		"gap": {
			"type": "number",
			"default": 24
		},
		"showArrows": {
			"type": "boolean",
			"default": true
		},
		"postType": {
			"type": "string",
			"default": "portfolio"
		},
		"perPage": {
			"type": "number",
			"default": 6
		},
		"label": {
			"type": "string",
			"default": "Slider"
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
