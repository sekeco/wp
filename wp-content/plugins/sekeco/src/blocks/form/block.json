{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/form",
	"version": "0.1.0",
	"title": "Sekeco Form",
	"category": "sekeco-utility",
	"description": "Embed a Sekeco form or one-page survey.",
	"keywords": [ "form", "survey", "contact", "feedback" ],
	"textdomain": "sekeco",
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
