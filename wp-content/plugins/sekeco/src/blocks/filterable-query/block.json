{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/filterable-query",
	"version": "0.1.0",
	"title": "Filterable Query",
	"category": "sekeco",
	"icon": "filter",
	"description": "Wrap a Query Loop and filter its items by taxonomy on the frontend.",
	"keywords": [ "filter", "query", "portfolio", "taxonomy" ],
	"textdomain": "sekeco",
	"attributes": {
		"taxonomy": {
			"type": "string",
			"default": "category"
		},
		"showAll": {
			"type": "boolean",
			"default": true
		},
		"allLabel": {
			"type": "string",
			"default": "All"
		},
		"filterLabel": {
			"type": "string",
			"default": "Filter by category"
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
