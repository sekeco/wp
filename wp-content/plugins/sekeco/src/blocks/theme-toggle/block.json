{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/theme-toggle",
	"version": "1.0.0",
	"title": "Theme toggle",
	"category": "sekeco-utility",
	"description": "A button that switches the site between light and dark. Icon, labelled pill, or the vertical rail used beside the page. The choice is remembered on this device.",
	"keywords": [ "dark mode", "light mode", "theme", "switcher" ],
	"textdomain": "sekeco",
	"attributes": {
		"variant": { "type": "string", "default": "icon" }
	},
	"supports": { "html": false, "anchor": true, "spacing": { "margin": true } },
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
