{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sekeco/process-step",
	"version": "1.0.0",
	"title": "Process step",
	"category": "sekeco-content",
	"description": "One numbered step.",
	"textdomain": "sekeco",
	"parent": [
		"sekeco/process"
	],
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"level": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"title": "Discover",
			"description": "We listen and agree on what success looks like."
		}
	}
}
