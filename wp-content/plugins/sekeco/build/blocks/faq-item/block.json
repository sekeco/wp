{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sekeco/faq-item",
  "version": "1.0.0",
  "title": "FAQ item",
  "category": "sekeco-content",
  "description": "One question with its answer blocks.",
  "textdomain": "sekeco",
  "parent": [
    "sekeco/faq"
  ],
  "attributes": {
    "question": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}