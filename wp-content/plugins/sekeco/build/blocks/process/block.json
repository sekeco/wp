{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sekeco/process",
  "version": "1.0.0",
  "title": "Process",
  "category": "sekeco-content",
  "description": "An ordered row of steps, numbered automatically.",
  "keywords": [
    "process",
    "steps",
    "workflow",
    "timeline"
  ],
  "textdomain": "sekeco",
  "attributes": {},
  "allowedBlocks": [
    "sekeco/process-step"
  ],
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "example": {
    "innerBlocks": [
      {
        "name": "sekeco/process-step",
        "attributes": {
          "title": "Discover",
          "description": "We listen and map the problem."
        }
      },
      {
        "name": "sekeco/process-step",
        "attributes": {
          "title": "Design",
          "description": "Prototypes you can react to."
        }
      }
    ]
  }
}