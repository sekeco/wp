{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sekeco/stats",
  "version": "1.0.0",
  "title": "Stats",
  "category": "sekeco-content",
  "description": "A quiet row of counted facts. Add Stat blocks that count published Works, Portfolio or Team entries.",
  "keywords": [
    "stats",
    "numbers",
    "counter"
  ],
  "textdomain": "sekeco",
  "attributes": {},
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": true
    }
  },
  "allowedBlocks": [
    "sekeco/stat"
  ],
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "example": {
    "innerBlocks": [
      {
        "name": "sekeco/stat",
        "attributes": {
          "value": "12",
          "suffix": "+",
          "label": "Sample number"
        }
      },
      {
        "name": "sekeco/stat",
        "attributes": {
          "value": "8",
          "label": "Another number"
        }
      }
    ]
  }
}