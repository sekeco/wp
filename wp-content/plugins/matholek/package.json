{
	"name": "matholek",
	"version": "0.1.0",
	"description": "Companion blocks for the Matholek theme.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [
		"@parcel/watcher",
		"core-js",
		"core-js-pure"
	],
	"scripts": {
		"build": "wp-scripts build --config webpack.config.js",
