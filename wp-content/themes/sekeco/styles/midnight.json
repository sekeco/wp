{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Midnight",
	"description": "A deep, low-light palette for the studio after dark.",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#09090B",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#FAFAFA",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#18181B",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#60A5FA",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#A78BFA",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#A1A1AA",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#27272A",
					"name": "Border",
					"slug": "border"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%)",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"gradient": "linear-gradient(180deg, #09090B 0%, #18181B 100%)",
					"name": "Fade",
					"slug": "fade"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"name": "Soft",
					"shadow": "0 1px 2px rgba(0, 0, 0, 0.4), 0 24px 48px -24px rgba(0, 0, 0, 0.7)",
					"slug": "soft"
				},
				{
					"name": "Glow",
					"shadow": "0 20px 60px -20px rgba(96, 165, 250, 0.45)",
					"slug": "glow"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				}
			},
			"core/separator": {
				"color": {
					"background": "var:preset|color|border"
				}
			}
		}
	}
}
