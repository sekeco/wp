{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"gradients": [],
			"palette": [
				{
					"color": "#F2EFE4",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111013",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#FAF8F2",
					"name": "Surface",
					"slug": "surface"
				},
				{
					"color": "#5E5C54",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#D8D3C3",
					"name": "Border",
					"slug": "border"
				},
				{
					"color": "#4A4F49",
					"name": "Accent (sage)",
					"slug": "accent"
				},
				{
					"color": "#F2EFE4",
					"name": "Accent contrast",
					"slug": "accent-contrast"
				},
				{
					"color": "#111013",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#F2EFE4",
					"name": "Paper",
					"slug": "paper"
				},
				{
					"color": "#F4B6A4",
					"name": "Salmon",
					"slug": "salmon"
				},
				{
					"color": "#D91842",
					"name": "Signal red",
					"slug": "red"
				},
				{
					"color": "#C8CCBD",
					"name": "Sage light",
					"slug": "sage-light"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "8px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "16px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(16px, 2vw, 24px)",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(24px, 4vw, 48px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(40px, 6vw, 88px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(72px, 10vw, 152px)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(96px, 14vw, 216px)",
					"slug": "80"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"name": "DM Sans (display)",
					"slug": "display",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					},
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "2.25rem"
					},
					"name": "Extra Large",
					"size": "1.875rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					},
					"name": "Extra Extra Large",
					"size": "2.75rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"min": "2.5rem",
						"max": "4.75rem"
					},
					"name": "Display",
					"size": "4rem",
					"slug": "hero"
				}
			]
		},
		"border": {
			"radiusSizes": [
				{
					"name": "Small",
					"size": "10px",
					"slug": "sm"
				},
				{
					"name": "Medium",
					"size": "20px",
					"slug": "md"
				},
				{
					"name": "Large",
					"size": "40px",
					"slug": "lg"
				},
				{
					"name": "Full",
					"size": "999px",
					"slug": "full"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Lift",
					"shadow": "0 2px 4px rgba(14, 16, 15, 0.06), 0 24px 48px -16px rgba(14, 16, 15, 0.28)",
					"slug": "lift"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/navigation": {
				"typography": {
					"fontSizes": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"letterSpacing": "0",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "500",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.04"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|hero",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.05"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					}
				}
			},
			"button": {
				"border": {
					"radius": "var:preset|border-radius|full"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "500",
					"letterSpacing": "0",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700",
					"letterSpacing": "-0.04em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							}
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "normal",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.025em"
				},
				"border": {
					"left": {
						"color": "var:preset|color|border",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/separator": {
				"color": {
					"background": "var:preset|color|border"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"core/image": {
				"border": {
					"radius": "var:preset|border-radius|md"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sekeco-menu",
			"title": "Menu overlay",
			"area": "navigation-overlay"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "Page (wide)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-landing",
			"title": "Landing page (sections and closing call to action)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-canvas",
			"title": "Canvas (no header or footer)",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "form-canvas",
			"title": "Form canvas (no header or footer)",
			"postTypes": [
				"sekeco_form"
			]
		}
	]
}
