{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "mist", "name": "Kabut (latar)", "color": "#F5F7F7" },
				{ "slug": "surface", "name": "Kartu", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Teks", "color": "#0A3340" },
				{ "slug": "teal-50", "name": "Teal 50", "color": "#EEF6F7" },
				{ "slug": "teal-100", "name": "Teal 100", "color": "#D6EBEE" },
				{ "slug": "teal-500", "name": "Teal 500", "color": "#1B7A8C" },
				{ "slug": "teal-700", "name": "Teal 700", "color": "#0F4C5C" },
				{ "slug": "teal-900", "name": "Teal 900", "color": "#0A3340" },
				{ "slug": "gold-100", "name": "Emas 100", "color": "#FAF1D9" },
				{ "slug": "gold-400", "name": "Emas 400", "color": "#D4A72C" },
				{ "slug": "gold-500", "name": "Emas 500", "color": "#B88A12" },
				{ "slug": "white", "name": "Putih", "color": "#FFFFFF" }
			],
			"gradients": [
				{
					"slug": "teal-gold",
					"name": "Teal ke emas",
					"gradient": "linear-gradient(135deg, #0F4C5C, #D4A72C)"
				}
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ]
		},
		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Manrope",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "amiri",
					"name": "Amiri (Arab)",
					"fontFamily": "Amiri, serif",
					"fontFace": [
						{
							"fontFamily": "Amiri",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/amiri-arabic-400-normal.woff2" ],
							"unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EEFF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS", "size": "0.75rem" },
				{ "slug": "sm", "name": "S", "size": "0.875rem" },
				{ "slug": "base", "name": "M", "size": "1rem" },
				{ "slug": "lg", "name": "L", "size": "1.125rem" },
				{ "slug": "2xl", "name": "XL", "size": "1.5rem" },
				{ "slug": "3xl", "name": "2XL", "size": "1.875rem" },
				{ "slug": "4xl", "name": "3XL", "size": "2.25rem" },
				{ "slug": "5xl", "name": "4XL", "size": "3rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--mist)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": { "top": "0px", "right": "0px", "bottom": "0px", "left": "0px" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "1rem",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--gold-400)",
					"text": "var(--wp--preset--color--teal-900)"
				},
				"border": { "radius": "1rem", "width": "0px" },
				"spacing": { "padding": { "top": "0.875rem", "right": "1.5rem", "bottom": "0.875rem", "left": "1.5rem" } },
				"typography": { "fontSize": "1rem", "fontWeight": "700", "lineHeight": "1.5" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
